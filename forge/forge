#!/bin/sh
# Wrapper for the forge CLI.
#
# Two things it settles:
#
# 1. On this machine every `.pth` written into site-packages ends up flagged hidden, and
#    CPython's `site` module skips hidden path files. An editable install therefore
#    succeeds and is then invisible to imports. PYTHONPATH is not subject to that.
#
# 2. This repository ships no pack. The framework is mechanism; the rules that drive it
#    are supplied from outside and are not public. Point DRAMATIS_PACKS at the directory
#    *containing* a `packs/` tree, or set PYTHONPATH yourself.
here=$(cd "$(dirname "$0")" && pwd)
packs=${DRAMATIS_PACKS:-}
PYTHONPATH="$here/src${packs:+:$packs}${PYTHONPATH:+:$PYTHONPATH}" \
  exec "$here/.venv/bin/python" -m dramatis_forge "$@"
